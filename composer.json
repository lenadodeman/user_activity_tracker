      "name": "ldodeman",
      "role": "maintainer"
    }
  ],
  "support": {
    "issues": "https://www.drupal.org/project/user_activity_tracker/issues",
    "source": "https://git.drupal.org/project/user_activity_tracker.git"
  },
  "homepage": "https://www.drupal.org/project/user_activity_tracker",
  "require": {
    "drupal/core": "^11.1"
  },
  "require-dev": {
    "drupal/core-dev": "^11.1"
  }
}
